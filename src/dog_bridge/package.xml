<?xml version="1.0"?>
<package format="3">
  <name>dog_bridge</name>
  <version>0.1.0</version>
  <description>Bridge between the RACER exploration FSM (decision layer) and the
    SCAN-Planner quadruped stack (execution layer) - Plan B.</description>
  <maintainer email="sigma@example.com">sigma</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>bspline</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
